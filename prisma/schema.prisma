// ============================================================================
// Flux — Prisma Schema (espelhado 1:1 com o Supabase PostgreSQL em produção)
// Projeto Supabase: luimqphsuecbelntlybg (flux-app)
// ============================================================================
// Observações de arquitetura:
// 1. Todas as tabelas residem no schema `public` com RLS habilitado por usuário.
// 2. `Profile.id` referencia `auth.users(id)` (Supabase Auth) com ON DELETE CASCADE.
// 3. Valores monetários utilizam `Decimal @db.Decimal(12, 2)` (precisão exata em centavos).
// 4. `DIRECT_URL` é usado pelo Prisma para migrations; `DATABASE_URL` via Supavisor (pgBouncer).
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum TransactionType {
  expense
  income

  @@map("transaction_type")
}

enum CardTone {
  white
  lilac
  gradient

  @@map("card_tone")
}

enum ThemePreference {
  dark
  light
  system

  @@map("theme_preference")
}

// ----------------------------------------------------------------------------
// Models
// ----------------------------------------------------------------------------

/// Perfil financeiro e preferências do usuário (1:1 com auth.users).
/// Criado automaticamente via trigger `on_auth_user_created`.
model Profile {
  id             String          @id @db.Uuid
  name           String
  email          String
  avatarUrl      String?         @map("avatar_url")
  initialBalance Decimal         @default(16840.00) @map("initial_balance") @db.Decimal(12, 2)
  cashAdjustment Decimal         @default(0.00) @map("cash_adjustment") @db.Decimal(12, 2)
  monthlyBudget  Decimal         @default(3200.00) @map("monthly_budget") @db.Decimal(12, 2)
  hideOnOpen     Boolean         @default(false) @map("hide_on_open")
  theme          ThemePreference @default(dark)
  isDemo         Boolean         @default(false) @map("is_demo")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  categories        Category[]
  cards             Card[]
  invoiceBatches    InvoiceBatch[]
  transactions      Transaction[]
  goals             Goal[]
  goalContributions GoalContribution[]

  @@map("profiles")
}

/// Categorias de gasto por usuário (6 padrão protegidas + categorias customizadas).
/// Ao excluir uma categoria customizada, o trigger `trg_categories_before_delete`
/// move os gastos vinculados para 'Outros'.
model Category {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  name         String
  monthlyLimit Decimal  @default(300.00) @map("monthly_limit") @db.Decimal(12, 2)
  tone         String   @default("muted")
  isDefault    Boolean  @default(false) @map("is_default")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name], map: "categories_user_name_unique")
  @@index([userId, sortOrder], map: "idx_categories_user_sort")
  @@map("categories")
}

/// Cartões cadastrados manualmente pelo usuário.
/// Ao excluir um cartão, `transactions.card_id` e `invoice_batches.card_id` viram NULL (Dinheiro / Pix).
model Card {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String
  last4       String   @db.Char(4)
  billAmount  Decimal  @default(0.00) @map("bill_amount") @db.Decimal(12, 2)
  creditLimit Decimal  @map("credit_limit") @db.Decimal(12, 2)
  dueDay      Int      @map("due_day") @db.SmallInt
  tone        CardTone @default(gradient)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile        Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceBatches InvoiceBatch[]
  transactions   Transaction[]

  @@index([userId], map: "idx_cards_user_id")
  @@map("cards")
}

/// Lotes de faturas importadas (PDF ou foto armazenados no bucket privado `invoices`).
/// Ao excluir um lote, todas as transações vinculadas são removidas em cascata (`ON DELETE CASCADE`).
model InvoiceBatch {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  cardId      String?  @map("card_id") @db.Uuid
  fileName    String   @map("file_name")
  storagePath String?  @map("storage_path")
  itemsCount  Int      @default(0) @map("items_count")
  totalAmount Decimal  @default(0.00) @map("total_amount") @db.Decimal(12, 2)
  importedAt  DateTime @default(dbgenerated("CURRENT_DATE")) @map("imported_at") @db.Date
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile      Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  card         Card?         @relation(fields: [cardId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([userId, importedAt(sort: Desc)], map: "idx_invoice_batches_user_imported")
  @@index([cardId], map: "idx_invoice_batches_card_id")
  @@map("invoice_batches")
}

/// Movimentações financeiras (despesas e receitas).
/// Constraint no banco: receitas (`type = 'income'`) não possuem `card_id`.
model Transaction {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String          @map("user_id") @db.Uuid
  cardId     String?         @map("card_id") @db.Uuid
  batchId    String?         @map("batch_id") @db.Uuid
  type       TransactionType @default(expense)
  name       String
  category   String
  amount     Decimal         @db.Decimal(12, 2)
  occurredAt DateTime        @default(dbgenerated("CURRENT_DATE")) @map("occurred_at") @db.Date
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  card    Card?         @relation(fields: [cardId], references: [id], onDelete: SetNull)
  batch   InvoiceBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt(sort: Desc)], map: "idx_transactions_user_date")
  @@index([userId, type, category], map: "idx_transactions_user_type_category")
  @@index([cardId], map: "idx_transactions_card_id")
  @@index([batchId], map: "idx_transactions_batch_id")
  @@map("transactions")
}

/// Objetivos / metas financeiras de longo prazo ("Grandes planos").
model Goal {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  name         String
  savedAmount  Decimal   @default(0.00) @map("saved_amount") @db.Decimal(12, 2)
  targetAmount Decimal   @map("target_amount") @db.Decimal(12, 2)
  targetDate   DateTime? @map("target_date") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile       Profile            @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]

  @@index([userId, createdAt(sort: Desc)], map: "idx_goals_user_created")
  @@map("goals")
}

/// Histórico de aportes e resgates em metas financeiras.
model GoalContribution {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  goalId    String   @map("goal_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  amount    Decimal  @db.Decimal(12, 2)
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  goal    Goal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalId, createdAt(sort: Desc)], map: "idx_goal_contributions_goal_id")
  @@index([userId], map: "idx_goal_contributions_user_id")
  @@map("goal_contributions")
}
